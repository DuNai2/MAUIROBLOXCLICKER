<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RobloxClicker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RobloxClicker"
    Shell.FlyoutBehavior="Disabled"
    Title="Roblox Clicker">

    <TabBar>
        <Tab Title="Кликер" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" />
        </Tab>
        <Tab Title="Улучшения" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:UpgradesPage}" />
        </Tab>
        <Tab Title="Достижения" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:AchievementsPage}" />
        </Tab>
    </TabBar>
</Shell>