<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RobloxClicker.MainPage"
             x:Name="MainPageRoot"
             BackgroundColor="#0A1428"
             Title="Кликер">

    <Grid>
        <VerticalStackLayout Padding="20" Spacing="18" VerticalOptions="Fill">

            <!-- Header -->
            <Grid>
                <Label Text="ROBLOX CLICKER" 
                       FontSize="36" 
                       FontAttributes="Bold" 
                       TextColor="#00D4FF" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>

                <Button Text="🔄" 
                        Clicked="ResetProgress"
                        BackgroundColor="#1E3A8A"
                        TextColor="White"
                        FontSize="18"
                        WidthRequest="45"
                        HeightRequest="45"
                        CornerRadius="22"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,0,10,0"/>
            </Grid>

            <!-- Robux -->
            <Border BackgroundColor="#1E2937" 
                    Stroke="#00D4FF" 
                    StrokeThickness="4" 
                    Padding="20" 
                    HorizontalOptions="Center" 
                    WidthRequest="360">
                <Label x:Name="RobuxLabel" 
                       Text="Robux: 0" 
                       FontSize="34" 
                       FontAttributes="Bold" 
                       TextColor="#00FFAA" 
                       HorizontalOptions="Center"/>
            </Border>

            <!-- Прогресс -->
            <VerticalStackLayout Spacing="6" Margin="0,0,0,10">
                <Label Text="Прогресс до следующего аватара" 
                       TextColor="#94A3B8" 
                       HorizontalOptions="Center" 
                       FontSize="16"/>
                <ProgressBar x:Name="ProgressBar" 
                             Progress="0" 
                             ProgressColor="#00D4FF" 
                             HeightRequest="14"/>
                <Label x:Name="NextMilestoneLabel" 
                       Text="До 10 000 Robux" 
                       TextColor="#64748B" 
                       HorizontalOptions="Center" 
                       FontSize="15"/>
            </VerticalStackLayout>

            <!-- Кнопка клика -->
            <ImageButton x:Name="ClickButton" 
                         Source="dotnet_bot.png" 
                         HeightRequest="240" 
                         WidthRequest="240" 
                         HorizontalOptions="Center" 
                         BackgroundColor="Transparent" 
                         Clicked="OnClickButtonClicked"/>

            <!-- Статистика -->
            <Label x:Name="StatsLabel" 
                   Text="1 Robux за клик" 
                   HorizontalOptions="Center" 
                   TextColor="#94A3B8" 
                   FontSize="18"/>

        </VerticalStackLayout>

        <!-- Попап -->
        <Frame x:Name="PopupFrame"
               IsVisible="False"
               BackgroundColor="#1E2937"
               BorderColor="#00D4FF"
               CornerRadius="28"
               Padding="30"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               WidthRequest="320"
               HeightRequest="380"
               ZIndex="1000">
            <VerticalStackLayout Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">
                <Image x:Name="PopupImage" Source="achievement_67.png" Aspect="AspectFit" HeightRequest="220" WidthRequest="220"/>
                <Label Text="67 КЛИКОВ!" FontSize="28" FontAttributes="Bold" TextColor="#00D4FF" HorizontalOptions="Center"/>
                <Label Text="Крутой результат!" FontSize="17" TextColor="#94A3B8" HorizontalOptions="Center"/>
                <Button Text="Продолжить" Clicked="ClosePopup" BackgroundColor="#00D4FF" TextColor="#0A1428" CornerRadius="12" HeightRequest="60" WidthRequest="220" FontSize="18"/>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>